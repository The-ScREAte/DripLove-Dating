    "clsx": "^2.1.1",
    "cordova-plugin-purchase": "^13.18.0",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "firebase": "^12.5.0",
    "heic2any": "^0.0.4",
    "hls.js": "^1.7.4",
    "i18next": "^26.7.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "lucide-react": "^0.525.0",
    "nanoid": "^5.1.16",
    "next-themes": "^0.4.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-easy-crop": "^6.2.3",
    "react-helmet": "^6.1.0",
    "react-i18next": "^16.2.4",
    "react-router-dom": "^7.12.0",
    "serve": "^14.2.8",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.11",
    "@eslint/js": "^9.39.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/react-helmet": "^6.1.11",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "patch-package": "^8.0.0",
    "rollup-plugin-visualizer": "^6.0.3",
    "sharp": "^0.34.5",
    "tailwindcss-animate": "^1.0.7",
    "terser": "^5.44.1",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.50.1",
    "vite": "^6.2.1",
    "vitest": "^3.2.4"
  },
  "browserslist": [
    "ios >= 15",
    "safari >= 15",
    "chrome >= 92",
    "android >= 92"
  ],
  "overrides": {
    "postcss": {
      ".": "^8.5.23",
      "nanoid": "^3.3.17"
    },
    "browserslist": "^4.28.7",
    "ws": "^8.21.0",
    "@grpc/grpc-js": "^1.14.5",
    "protobufjs": "^7.6.5",
    "websocket-driver": "^0.8.0",
    "websocket-extensions": "^0.2.0"
  }
}
