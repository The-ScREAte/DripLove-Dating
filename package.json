{
  "name": "driplove-dating-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:dev": "tsc && vite build --mode development",
    "build:capacitor": "tsc && vite build --mode capacitor",
    "build:android": "npm run build:capacitor",
    "postinstall": "patch-package || ( [ \"$RENDER\" = \"true\" ] && echo 'patch-package failed on Render; continuing web deploy' || exit 1 )",
    "start": "serve dist -l 10000",
    "test": "vitest run",
    "test:google:iap": "node scripts/test-google-iap-validator.mjs",
    "get:user:id": "node scripts/get-user-id.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "sync:android": "npm run build:capacitor && cap sync android",
    "sync:ios": "npm run build:capacitor && cap sync ios",
    "sync:native": "npm run build:capacitor && cap sync",
    "android:build": "npm run sync:android",
    "android:dev": "npm run sync:android && cap open android",
    "android:run": "npm run sync:android && cap run android",
    "ios:build": "npm run sync:ios",
    "ios:dev": "npm run sync:ios && cap open ios",
    "ios:run": "npm run sync:ios && cap run ios"
  },
  "dependencies": {
    "@capacitor-community/apple-sign-in": "^7.1.0",
    "@capacitor-community/camera-preview": "^7.0.2",
    "@capacitor-community/privacy-screen": "^6.1.0",
    "@capacitor-community/safe-area": "^7.0.0",
    "@capacitor-firebase/messaging": "^7.4.0",
    "@capacitor/android": "^7.6.11",
    "@capacitor/app": "^7.0.1",
    "@capacitor/app-launcher": "^8.0.0",
    "@capacitor/browser": "^7.0.2",
    "@capacitor/camera": "^7.0.2",
    "@capacitor/core": "^7.6.11",
    "@capacitor/ios": "^7.6.11",
    "@capacitor/keyboard": "^7.0.1",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/push-notifications": "^7.0.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@southdevs/capacitor-google-auth": "^7.0.0",
    "@stripe/react-stripe-js": "^6.8.2",
    "@stripe/stripe-js": "^9.14.0",
    "@supabase/supabase-js": "^2.51.0",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-virtual": "^3.13.13",
    "autoprefixer": "^10.4.21",
    "browser-image-compression": "^2.0.2",
