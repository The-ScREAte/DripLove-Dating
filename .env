# Stripe (advertiser card-on-file collection in Profile > Advertisement).
# These are PUBLISHABLE keys only - safe for frontend code by design. Secret
# keys live server-side only, in Supabase Edge Function secrets
# (STRIPE_SECRET_KEY_TEST / STRIPE_SECRET_KEY_LIVE), never here. Which of
# these two the app actually uses is decided at runtime by the stripe_mode
# row in app_settings (toggle in Admin > Ads Management > Stripe Settings),
# not by anything here.
VITE_STRIPE_PUBLISHABLE_KEY_TEST="pk_test_51UAF502Mk8f31NsPEWxIymQuSqXLH6NPNPHUT6qLMnUKbEtVgiWDbLr3uQNmMKN0C0f8Roc6s0p7zCOz63BDmoS000mqLMNNG4"
# NOTE: this one started as "mk_1UAEktRstr5fFHBjFr8Z2Cs0" instead of Stripe's
# usual "pk_live_" prefix - kept as given, but double check this is the right
# Publishable key from the Stripe Dashboard (Developers > API keys, Live
# mode) if live-mode card collection fails to load.
VITE_STRIPE_PUBLISHABLE_KEY_LIVE="mk_1UAEktRstr5fFHBjFr8Z2Cs0"

# Paystack Configuration (Test Mode)
VITE_PAYSTACK_MODE=test
VITE_PAYSTACK_PUBLIC_KEY_TEST="pk_test_44216f70d964991e1b200b527be2e4d234096dda"
VITE_PAYSTACK_PUBLIC_KEY_LIVE="pk_live_48a5156dda6e56d0b62c2a528181fd780eb2a034"

