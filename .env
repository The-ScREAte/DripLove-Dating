# Explicit Services ID for Sign in with Apple (ensures the app always passes the correct clientId)
# Add this to CI/CD / Xcode build env as well so production builds are consistent.
VITE_APPLE_SERVICES_ID="com.driplove.dating.signin"

# IMPORTANT: Apple Developer Console Setup Required
# 
# 1. Services ID Configuration (com.driplove.dating.signin):
#    - Add these domains to "Domains and Subdomains":
#      * localhost (for development)
#      * fef6ab36-77bc-4046-b6f5-fc5b2ad8c182.lovableproject.com (for production)
# 
# 2. Add these redirect URIs to "Website URLs":
#    - http://localhost:8080/auth/apple-callback
#    - http://localhost:8081/auth/apple-callback  
#    - https://fef6ab36-77bc-4046-b6f5-fc5b2ad8c182.lovableproject.com/auth/apple-callback
#
# 3. Make sure "Sign In with Apple" is enabled for both App ID and Services ID

# Production Environment
VITE_BUILD_MODE=production

# SMTP-first email migration (local)
VITE_EMAIL_SERVICE_URL="http://localhost:3001"
VITE_EMAIL_SERVICE_API_KEY="YourSuperSecretKey"

# Supabase CLI personal access token (for `npx supabase db query --linked`,
# `functions deploy`, etc. from this machine only). Deliberately NOT prefixed
# with VITE_ - a VITE_ prefix gets bundled into the public client build, and
# this token grants broad account-level API access, so it must never ship to
# the browser. CLI-only use: `export SUPABASE_ACCESS_TOKEN=$(grep ... )` or
# source this file in a shell script - never reference it from src/.
SUPABASE_ACCESS_TOKEN="sbp_fcafb69076de3910c17385ae7f12550c1f5f488f"
