<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <!-- The AppCompat.Light parent's default window background is white/light, which
             paints for a frame before the (transparent-background) WebView loads and before
             its own black CSS background takes over - a real white flash on cold start on a
             genuinely all-dark app. This matches the WebView's actual background instead. -->
        <item name="android:windowBackground">@color/appWindowBackground</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <!-- Android 12+ (API 31+) System Splash Screen ignores android:background above and
             instead reads this directly - without it, it falls back to this theme's
             android:colorBackground (which resolves to the black appWindowBackground in
             AppTheme), showing a black screen behind the masked launcher-icon circle instead
             of the brand's pink. The circular masked icon itself is unaffected/unchanged -
             that part already renders correctly. Matches iOS LaunchScreen.storyboard's fixed
             #7a0a40 background. -->
        <item name="android:windowSplashScreenBackground">@color/splashBackground</item>
        <!-- API 31+ splash icon: previously unset, so the system fell back to the app's
             launcher icon (mipmap/ic_launcher). Pointed at the same logo artwork iOS's
             LaunchScreen.storyboard uses (Splash.imageset) instead, sized smaller than the
             launcher icon - splash-only, does not affect the home screen/app drawer icon. -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
</resources>